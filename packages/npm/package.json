{
  "name": "filekat",
  "version": "1.1.18",
  "description": "KAUI CSS Kit for modern Web, React, and Next.js applications",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/kaui.css",
  "style": "dist/kaui.min.css",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COMMERCIAL_LICENSE.md"
  ],
  "exports": {
    ".": {
      "style": "./dist/kaui.min.css",
      "default": "./dist/kaui.min.css"
    },
    "./kaui": {
      "style": "./dist/kaui.min.css",
      "default": "./dist/kaui.min.css"
    },
    "./css": "./dist/kaui.css",
    "./min.css": "./dist/kaui.min.css",
    "./charts": {
      "style": "./dist/kaui-chart.min.css",
      "default": "./dist/kaui-chart.min.js"
    },
    "./tokens/*": "./dist/tokens/*"
  },
  "homepage": "https://kaui.filekat.com",
  "keywords": [
    "css",
    "scss",
    "ui-kit",
    "design-tokens",
    "components",
    "responsive",
    "flexbox",
    "grid",
    "theme",
    "dark-mode",
    "filekat",
    "kaui"
  ]
}

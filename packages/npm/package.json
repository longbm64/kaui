    "./css": "./dist/kaui.css",
    "./min.css": "./dist/kaui.min.css",
    "./charts": { "style": "./dist/kaui-chart.min.css", "default": "./dist/kaui-chart.min.js" },
    "./tokens/*": "./dist/tokens/*"
  },
  "repository": { "type": "git", "url": "git+https://github.com/longbm64/kaui.git" },
  "bugs": { "url": "https://github.com/longbm64/kaui/issues" },

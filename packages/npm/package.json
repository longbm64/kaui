{
  "name": "filekat",
  "version": "1.1.0",
  "description": "KAUI CSS Kit for modern Web, React, and Next.js applications",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/kaui.css",
  "style": "dist/kaui.min.css",
  "type": "module",
  "publishConfig": { "access": "public" },
  "files": ["dist", "README.md", "LICENSE", "COMMERCIAL_LICENSE.md"],
  "exports": {
    ".": { "style": "./dist/kaui.min.css", "default": "./dist/kaui.min.css" },
